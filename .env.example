# Local development. In deployed environments every one of these is injected
# from AWS Secrets Manager as an ECS task secret — never from a file.

# The API and worker MUST connect as `bots_app`, NOT as the master user.
# The master user is a superuser and bypasses row-level security entirely, which
# would silently disable every tenant-isolation policy. See migrations/0001.
DATABASE_URL=postgres://bots_app:test@localhost:5433/bots

# Master user — migrations only. Never used to serve traffic.
MIGRATION_DATABASE_URL=postgres://bots:bots@localhost:5433/bots
REDIS_URL=redis://localhost:6380

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Defaults are the ids verified against the live API.
# GEMINI_CHAT_MODEL=gemini-3.1-flash
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-2
