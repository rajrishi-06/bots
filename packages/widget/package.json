{
  "name": "@bots/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "size": "size-limit",
