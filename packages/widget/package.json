  },
  "dependencies": {
    "@bots/core": "workspace:*",
    "@bots/pet-engine": "workspace:*",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "happy-dom": "^18.0.1",
    "size-limit": "^11.1.6",
    "typescript": "5.7.3",
    "vite": "^6.0.7",
    "vitest": "3.0.5"
  },
  "size-limit": [
    {
      "name": "petbot widget (gzip)",
      "path": "dist/petbot.js",
      "limit": "30 kB",
      "gzip": true
