{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petbot",
  "version": "0.1.0",
  "identifier": "dev.petbot.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:ui",
    "beforeBuildCommand": "pnpm run build:ui",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Petbot",
        "width": 220,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "chat",
        "title": "Petbot",
        "width": 400,
        "height": 620,
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.petbot.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "trayIcon": { "iconPath": "icons/icon.png", "tooltip": "Petbot" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
